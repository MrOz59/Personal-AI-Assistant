<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower (12+ uses data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Brain settings hold the API keys. They're Keystore-encrypted and unreadable on another
         device anyway, so keep them out of backups entirely. -->
    <exclude domain="sharedpref" path="naomi_brain.xml"/>
</full-backup-content>
